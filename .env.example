# Copy to .env and fill in.

# SQLite database file (relative to prisma/)
DATABASE_URL="file:./dev.db"

# Optional. When set, CV extraction, job-requirement parsing and CV tailoring
# use Claude. When unset, Rolexa falls back to its deterministic parser —
# everything still works, extraction is just less accurate on unusual layouts.
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# --- Job sources ------------------------------------------------------------
# The three remote boards (Remotive, RemoteOK, We Work Remotely) need no key and
# work out of the box. The two below widen coverage; both have free tiers.

# JSearch via RapidAPI — indexes Google Jobs, which carries LinkedIn, Indeed and
# Glassdoor postings. This is the supported way to reach those: all three block
# direct scraping. Worldwide coverage, including the Gulf.
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Adzuna — free tier, strong UK/EU/US/IN coverage. No UAE index.
# https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Market to search. One of: gb us at au be br ca ch de es fr in it mx nl nz pl sg za
# ADZUNA_COUNTRY=gb
